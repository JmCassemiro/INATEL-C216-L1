# Copie este arquivo para .env e ajuste os valores conforme necessario.
# O .env nao e versionado (esta no .gitignore) porque pode conter credenciais reais.
# Todas as variaveis abaixo possuem valor padrao no compose.yaml, entao o ambiente
# sobe mesmo sem o .env.

# Porta em que a API fica disponivel no host
API_PORT=8000

# Banco de dados
POSTGRES_DB=lionelmessi
POSTGRES_USER=flamengo
POSTGRES_PASSWORD=arrascaeta

# Porta em que o PostgreSQL fica disponivel no host.
# Use outra porta (ex: 5433) se ja houver um PostgreSQL instalado na maquina.
POSTGRES_PORT=5432
